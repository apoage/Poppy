+    `load_manifests` itself produced when the SAME `scan_dirs` list is passed here — this
+    function fails closed rather than guess when it is)."""
+    rp = os.path.realpath(source)
+    for sd in scan_dirs:
+        prefix = os.path.realpath(sd) + os.sep
+        if rp.startswith(prefix):
+            return rp[len(prefix):].split(os.sep, 1)[0]
+    return None
+
+
+def _run_dir_task_number(run_dir: str, roots: list[str]) -> str | None:
+    """The ONE task number `run_dir` itself designates, scoped to `roots`. THE single source of
+    truth for both the coverage decision (`_authority_correlated`) and the refusal-hint text —
+    there is deliberately no second way to compute this number.
+
+    Only the segments of `run_dir`'s path RELATIVE to a configured root are read. That scoping is
+    the whole of the cycle-2 BLOCKER fix: D64 binds coverage to "the run dir's task/experiment
+    segment", SINGULAR — the run's OWN owning id — and the previous implementation instead scanned
+    every segment of the full absolute realpath, so `/mnt/2tb_disk/runs/target` inherited "2" and
+    a scratch path `/tmp/claude-1000/1585d253-.../runs/x` inherited "1585". Segments ABOVE a root
+    are not this repo's task namespace and confer nothing.
+
+    FAIL-CLOSED — `None` (which `_authority_correlated` turns into "no correlation", i.e. REFUSE;
+    never into a grant) whenever the run dir designates no single owner:
+
+    * it resolves under no configured root at all (or IS a root);
+    * no relative segment is digit-led (`jax_ckpt_fast/e5exit2_pq_s0`, the disclosed 828 case);
+    * two or more DIFFERENT digit-led relative segments disagree about who owns it. `runs/000_smoke`
+      is a live shared scratch CONTAINER holding 30 entries belonging to unrelated tasks
+      (`753_step7`, `769_value_clip`, `771_chain_bugfix`, ...), so `runs/000_smoke/769_value_clip`
+      is owned by 769 and by 000 in equal measure by shape alone; likewise `runs/47_task/50_epoch`,
+      where `50_epoch` is an epoch counter and not a task id at all. Ambiguity is REFUSED, never
+      resolved by preferring one end of the path — picking the outer end hands a container id
+      standing over every child, picking the inner end hands an epoch counter standing over its
+      own run.
+
+    A single number, carried by one relative segment or repeated across several, is the owner:
+    `runs/832_e5` -> "832", `runs/875_wf/f1_s0` -> "875" (an owner dir with un-numbered children —
+    the real nested shape on this host's corpus), `runs/861/861_ref` -> "861".
+
+    Roots are considered ALL of them, not first-match, and their numbers are UNIONED, so a nested
+    root pair (`runs` and `runs/000_smoke`) cannot be used to launder an ambiguous run dir into an
+    unambiguous one by ordering.
+    """
+    rp = os.path.realpath(run_dir)
+    nums: set[str] = set()
+    rooted = False
+    for r in roots:
+        rr = os.path.realpath(r)
+        prefix = rr + os.sep
+        if rp == rr or not rp.startswith(prefix):
+            continue
+        rooted = True
+        nums |= {n for seg in rp[len(prefix):].split(os.sep)
+                 for n in (_task_number(seg),) if n is not None}
+    if not rooted or len(nums) != 1:
+        return None
+    return next(iter(nums))
+
+
+# Scope item 1's "explicit per-experiment allow-list": `{experiment_id: (run_dir_prefix, ...)}`.
+# A run dir under one of an id's listed prefixes is authorized for that id even with no numeric
+# correlation. EMPTY by construction — see the section banner above for why this row does not
+# populate it itself.
+_AUTHORITY_ALLOWLIST: dict[str, tuple[str, ...]] = {}
+
+
+def _authority_correlated(manifest_id: str, run_dir: str, roots: list[str]) -> bool:
+    """Does `manifest_id` have a DECLARED relationship to `run_dir` (scope item 1)? Either
+    automatic id-correlation, or an explicit `_AUTHORITY_ALLOWLIST` entry.
+
+    `roots` is the CONFIGURED checkpoint roots (`--roots` offline, `prune_run_dir_by_score`'s own
+    `roots=` in-run) and is what scopes the correlation to the run dir's OWN owning segment —
+    see `_run_dir_task_number`. An empty/omitted `roots` therefore correlates NOTHING (refuse),
+    which is the intended fail-closed direction: never a grant."""
+    num = _task_number(manifest_id)
+    own = _run_dir_task_number(run_dir, roots)
+    if num is not None and own is not None and num == own:
+        return True
+    run_rp = os.path.realpath(run_dir)
+    for prefix in _AUTHORITY_ALLOWLIST.get(manifest_id, ()):
+        prefix_rp = os.path.realpath(prefix)
+        if run_rp == prefix_rp or run_rp.startswith(prefix_rp + os.sep):
+            return True
+    return False
+
+
+# `ManifestSet.citations`' own, and only, line shape (`load_manifests`'s `_classify`): one
+# whitespace-free `entry.path` token (the manifest grammar guarantees this — 881G's item
+# micro-grammar never accepts a second token), so this format can never be produced with a
+# literal ' <- ' inside the path half, and parsing it back out here is safe. This file alone
+# produces this text; nothing external ever feeds it.
+_CITATION_LINE_RE = re.compile(r"^(?:protect|covers): \S+ <- (.+):(\d+)$")
+
+
+def _citation_manifest_ids(citation_lines: list[str], scan_dirs: list[str]) -> set[str]:
+    """The experiment id(s) of every manifest that cited this granted path, read back out of
+    `ManifestSet.citations`'s own format (see `_CITATION_LINE_RE`)."""
+    ids = set()
+    for line in citation_lines:
+        m = _CITATION_LINE_RE.match(line)
+        if not m:
+            continue
+        mid = _manifest_id_of(m.group(1), scan_dirs)
+        if mid is not None:
+            ids.add(mid)
+    return ids
+
+
+def _named_entries_under(run_dir: str, named: set[str]) -> list[str]:
+    """The subset of `named` that grants coverage to `run_dir` — the same test
+    `resolve_coverage` runs inline (kept as a private duplicate rather than a shared helper so
+    `resolve_coverage` itself stays byte-for-byte untouched; see the section banner)."""
+    rp = os.path.realpath(run_dir)
+    prefix = rp + os.sep
+    return [p for p in named if p == rp or p.startswith(prefix)]
+
+
+def _path_authorized(p: str, run_dir: str, citations: dict[str, list[str]],
+                     scan_dirs: list[str], roots: list[str]) -> bool:
+    """Is granted path `p` authorized to cover `run_dir` under the binding? A path with NO
+    citation (an operator `--protect-file` entry, never manifest-sourced) is untouched by the
+    binding — scope item 1 binds `covers:`/`protect:` MANIFEST entries only. A manifest-sourced
+    path is authorized only if at least one manifest that cited it correlates (fail-closed: a
+    citation whose source id cannot be determined authorizes nothing)."""
+    cite_lines = citations.get(p, [])
+    if not cite_lines:
+        return True
+    ids = _citation_manifest_ids(cite_lines, scan_dirs)
+    return any(_authority_correlated(mid, run_dir, roots) for mid in ids)
+
+
+def resolve_bound_coverage(run_dirs: list[str], named: set[str], missing: set[str] | None = None,
+                           *, citations: dict[str, list[str]] | None = None,
+                           scan_dirs: list[str] | None = None,
+                           roots: list[str] | None = None) -> dict[str, bool]:
+    """`resolve_coverage`'s own predicate, ANDed with the TASK_881E authority binding.
+
+    ADDITIVE BY CONSTRUCTION, not by care: this function's first act is to call
+    `resolve_coverage(run_dirs, named, missing)` UNCHANGED and use its dict as the starting
+    point. `citations`/`scan_dirs` omitted (either one) short-circuits to returning that dict
+    EXACTLY — the binding is off. When both are given, a run dir already `False` stays `False`
+    (no `and` can revive it), and one already `True` can only be pulled DOWN to `False` by the
+    `all(...)`-style `any(_path_authorized(...))` check below, never pushed up: there is no
+    branch anywhere in this function that sets a dir `True` the base predicate marked `False`. So
+    for every `rd`, `bound[rd] => resolve_coverage(...)[rd]` holds by inspection, which is the
+    "can only ever REMOVE coverage" guarantee scope item 1 requires.
+
+    `roots` is the CONFIGURED checkpoint roots, threaded down to `_run_dir_task_number` so the
+    correlation is scoped to each run dir's OWN owning segment (cycle-2 BLOCKER — see that
+    function). It is keyword-optional ONLY so that omitting it cannot raise inside the in-run
+    pruner's `apply=True` path (a raise there flips `train_jax_fast.py`'s exit code); omitting it
+    while the binding is ACTIVE correlates nothing and therefore REFUSES every manifest-sourced
+    grant. Fail-closed in the "refuses more" direction, never in the granting one.
+    """
+    coverage = resolve_coverage(run_dirs, named, missing)
+    if citations is None or scan_dirs is None:
+        return coverage
+    roots = list(roots) if roots else []
+    out = {}
+    for rd in run_dirs:
+        if not coverage[rd]:
+            out[rd] = False
+            continue
+        under = _named_entries_under(rd, named)
+        out[rd] = any(_path_authorized(p, rd, citations, scan_dirs, roots) for p in under)
+    return out
+
+
+def authority_binding_refusal_hint(run_dir: str, roots: list[str], named: set[str],
+                                   citations: dict[str, list[str]],
+                                   scan_dirs: list[str]) -> str:
+    """Scope item 2 — actionable refusal text naming the manifest that WOULD have standing over
+    `run_dir`, instead of "an experiments/<id>/PROTECTED.txt" (any id), which is D64's own
+    attack shape. Callers must only use this once the binding is ACTUALLY active — with no
+    binding, any id currently has standing, and this text would be false."""
+    citing_ids: set[str] = set()
+    for p in _named_entries_under(run_dir, named):
+        citing_ids |= _citation_manifest_ids(citations.get(p, []), scan_dirs)
+    num = _run_dir_task_number(run_dir, roots)
+    if num is not None:
+        standing = (f"add it to experiments/{num}_*/PROTECTED.txt (an experiment id starting "
+                    f"with {num!r} — this run dir's own task-number segment) or a "
+                    f"`protected:`/`covers:` block in that experiment's SPEC.md, or add a "
+                    f"reviewed exception for the citing id to tools/ckpt_gc.py's "
+                    f"_AUTHORITY_ALLOWLIST (TASK_881E, D64)")
+    else:
+        standing = (f"this run dir's path designates no single owning task number under the "
+                    f"configured roots {sorted(roots)!r} (it carries none, or two segments "
+                    f"disagree — e.g. a shared numeric container holding another task's run, "
+                    f"which is refused rather than resolved), so no id-correlated manifest can "
+                    f"grant it coverage — only a reviewed exception in tools/ckpt_gc.py's "
+                    f"_AUTHORITY_ALLOWLIST can (TASK_881E, D64)")
+    if citing_ids:
+        return (f"{sorted(citing_ids)} names this run dir but has no declared relationship to "
+                f"it under TASK_881E's authority binding (D64) — {standing}")
+    return f"no manifest names it at all — {standing}"
+
+
