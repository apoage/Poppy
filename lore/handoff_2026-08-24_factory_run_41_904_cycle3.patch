+def _corridor_refusal_test(db, smoke_root, pad_days):
+    """TASK_904 (cycle 3 / F2) battery for the CORRIDOR write gate — the sibling writer
+    the cycle-2 redesign missed (``corridor``'s CLI defaults point at the TRACKED
+    folds/real/ tree, and its corridor.json files ARE tracked).
+
+      1. ``idempotent_recompute_not_rewritten`` — POSITIVE control: re-running corridors
+         over a tree whose corridors this call reproduces exactly writes NOTHING and
+         leaves the tree byte-identical (this is what makes a bare ``corridor`` harmless
+         on unchanged inputs, rather than merely provenance-approved);
+      2. ``corridor_content_change_needs_flag`` — an existing corridor whose content the
+         recomputation would CHANGE is refused without the explicit opt-in;
+      3. ``corridor_fixture_over_real_even_with_flag`` — a corridor recording a REAL db
+         is never replaced with fixture-derived content, flag or no flag, and is refused
+         BEFORE any corridor is computed."""
+    out = []
+    # ---- 1. idempotent recompute -> no write at all ----
+    before = _hash_tree(smoke_root)
+    written = corridor_for_root(db, smoke_root, SMOKE_FOLDS, pad_days=pad_days)
+    after = _hash_tree(smoke_root)
+    if written or after != before:
+        raise RuntimeError(
+            f"CORRIDOR GATE FAILED: recomputing identical corridors wrote {written} and "
+            f"changed the tree ({before} -> {after}) — an idempotent recompute must "
+            f"rewrite nothing")
+    print("[837][positive:idempotent_recompute_not_rewritten] identical corridors NOT "
+          "rewritten (tree byte-identical)")
+    out.append({"case": "idempotent_recompute_not_rewritten", "rejected": False,
+                "paths_written": [], "tree_hash_unchanged": True})
+
+    folds_dir = os.path.join(EXP_DIR, "folds")
+    scratch = tempfile.mkdtemp(prefix=_SCRATCH_PREFIX + "corridorgate_", dir=folds_dir)
+    try:
+        # ---- 2. content would CHANGE -> refuse without the flag ----
+        tree = os.path.join(scratch, "changed")
+        shutil.copytree(smoke_root, tree, ignore=shutil.ignore_patterns("_negative"))
+        cp = _corridor_path(tree, SMOKE_FOLDS[0]["fold_id"])
+        cor = json.load(open(cp))
+        cor["per_tier"]["21"]["floor_inenv"] = -99.0      # a number the recompute won't
+        _write_json(cp, cor)                              # reproduce
+        out.append(_expect_refusal(
+            "corridor_content_change_needs_flag", tree,
+            lambda: corridor_for_root(db, tree, SMOKE_FOLDS, pad_days=pad_days)))
+
+        # ---- 3. fixture-over-real -> refuse even WITH the flag, before computing ----
+        real_tree = os.path.join(scratch, "realcorridor")
+        shutil.copytree(smoke_root, real_tree, ignore=shutil.ignore_patterns("_negative"))
+        rp = _corridor_path(real_tree, SMOKE_FOLDS[0]["fold_id"])
+        cor = json.load(open(rp))
+        cor["db"] = "trading_data.db"       # stands in for a real-db corridor
+        _write_json(rp, cor)
+        out.append(_expect_refusal(
+            "corridor_fixture_over_real_even_with_flag", real_tree,
+            lambda: corridor_for_root(db, real_tree, SMOKE_FOLDS, pad_days=pad_days,
+                                      allow_overwrite=True)))
+    finally:
+        shutil.rmtree(scratch, ignore_errors=True)
+    return out
