+def test_mid_value_age_reflects_the_frozen_run_not_the_last_keepalive_event():
+    """RED against HEAD: `MidQuote`/`MidSeries.mid_at` carry no `value_age_s` at all
+    (`TypeError`/`AttributeError`).
+
+    A book keepalive-repeats the SAME `(bid, ask)` every 5s for a minute, then a query lands
+    right after the latest repeat. `age_s` (by TIMESTAMP) reads a few seconds; `value_age_s` (by
+    VALUE) must read the full run length — the mid has not actually been fresh since it started.
+    """
+    series = MidSeries()
+    t = 0.0
+    while t <= 65.0:
+        series.add_book(t, 100.0, 100.2)  # identical (bid, ask) the whole time
+        t += 5.0
+    quote = series.mid_at(66.0)
+    assert quote is not None
+    assert quote.age_s < 5.0, "sanity: the last book EVENT was seconds ago"
+    assert quote.value_age_s > 60.0, (
+        "the PRICE has not changed since t=0 — value age must reflect the whole frozen run, not "
+        "the last keepalive repeat")
+
