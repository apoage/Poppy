+"""TASK_907 ADDENDUM B2 (`907B-2`, run-50) — the stale-book exclusion, re-cut per D73/D74 around
+the right question: what makes a BOOK-MID estimand trustworthy.
+
+Five items, each pinned RED-then-GREEN below:
+
+  1. A book-mid FRESHNESS term denominated in BOOK observations ONLY (`PairCoverage.
+     book_uncovered_fraction`) — independent of whether trades carried coverage. THE
+     denomination fix; see `capture.PairCoverage.book_covered_s`. **Cycle 2 (BLOCKER):** an
+     "observation" here is WIRE EVIDENCE — an event whose FULL `(bid, ask, bid_sz, ask_sz)`
+     payload repeats the previous one is our own keepalive echo and does not count; anything else
+     does. Cycle 1 reused the `(bid, ask)` stale filter, which measures "did the price change"
+     and scored a book transmitting every second WORSE than one that had stopped.
+  2. The two defect signals (keepalive overruns; trades walking through an unchanging book) as
+     EXCLUSION disqualifiers, each with its OWN denominator fix:
+       (a) the B1-shipped, RENDERED `book_keepalive_overruns` keeps EXACTLY its B1 rule (interval
+           minus recorded-gap time still over the floor). The strict "ZERO recorded-gap overlap"
+           variant is a SEPARATE, ADDITIVE field and is the only one the exclusion layer consumes
+           — cycle 2 BLOCKER: cycle 1 redefined the shipped field in place and deleted the
+           disclosure for every partially-explained silence;
+       (b) the outside-book rate is measured PER FROZEN RUN against the pair's own OUT-OF-FREEZE
+           baseline — never the raw rate (INVERTED on a fine-tick venue), never a self-polluted
+           baseline that includes the frozen trades under test, and never a pooled per-pair
+           average that lets one bad run dilute to invisibility (all three were cycle-2
+           BLOCKERs). Frozen-run membership is tested on the trade's own `venue_ts`, never local
+           receipt time. A run under `OUTSIDE_BOOK_MIN_FROZEN_TRADES` reads NOT ASSESSED, never
+           clean. What a flagged run DOES is `OUTSIDE_BOOK_EXCESS_RESPONSE`, UNRULED.
+  3. Per-pair EXCLUSION, not a whole-capture refusal (`CaptureMetadata.
+     b2_freshness_disqualified_pairs`, consumed by `cli.py`) — one disqualified pair no longer
+     voids every other pair's numbers in the same capture. B4's cross-capture collision check
+     runs BEFORE the exclusion, so the notice can never contradict the report (cycle 2, MAJOR).
+  4. TRUE mid age — age by VALUE (`shadow_engine.MidQuote.value_age_s`), not just by timestamp.
+  5. Receipt-lag denomination (D74) — per-hour distribution, the markout-timing distortion it
+     implies at each horizon, explicit negative-lag handling, and (cycle 2) the markout ANCHOR
+     re-timed on `venue_ts` as a DIAGNOSTIC over the exact samples backing the published numbers.
+
+**EVERY numeric bound this addendum introduces is UNRULED** and is going to the operator as a
+decision row. No test here may be made green by choosing a threshold value; the tests pin the
+MECHANISM and the DISCLOSURE (measured value printed next to its bound), never a chosen number.
+
+Every fixture here is built through the REAL production `CaptureWriter` (no monkeypatching, no
+bypass) — the same discipline every other file in this suite uses.
+"""
+import sys
+from pathlib import Path  # noqa: F401 (used throughout — CLI tests read rendered output files)
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from capture import (  # noqa: E402
+    OUTSIDE_BOOK_EXCESS_FACTOR, OUTSIDE_BOOK_MIN_FROZEN_TRADES, STALE_BOOK_MIN_RUN_S,
+    CaptureWriter, GapRecord, read_capture,
+)
+from estimands import Estimand1Result, HorizonAdverseSelection  # noqa: E402
+from recorder import BOOK_EMISSION_POLICY, SUBSCRIBED_CHANNELS  # noqa: E402
+from render import render_report  # noqa: E402
+from shadow_engine import MidSeries  # noqa: E402
+import cli  # noqa: E402
+
+T0 = 1_700_000_000.0
+
+
+# =================================================================================================
+# item 1 — the book-mid-only freshness term (THE denomination fix)
+# =================================================================================================
+
+def _write_book_dies_trades_flow(path, book_stop_s=1800.0, span_s=3600.0, pair="BTC/USD"):
+    """The exact D73/B1 repro shape: BOOK dies at `book_stop_s` while TRADES keep printing for
+    the whole capture. `test_coverage_aggregate.py::
+    test_book_dying_while_trades_keep_flowing_is_NOT_caught_by_B1_pending_addendum_b2` pins this
+    shape at the UNION-denominated level (unchanged by B2, on purpose — B-v). This is the SAME
+    fixture, used here to exercise the book-ONLY instrument B2 adds.
+    """
+    w = CaptureWriter(str(path), [pair], "capB2Death", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    t, bid = 0.0, 100.0
+    while t <= book_stop_s:
+        w.write_book(pair, t, bid, bid + 0.2, 1.0, 1.0)
+        bid += 0.001
+        t += 5.0
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 10.0
+    t = 0.0
+    while t <= span_s:
+        w.write_trade(pair, t, bid, 0.5, "buy" if int(t) % 2 == 0 else "sell", venue_ts=t)
+        t += 10.0
+    w.close(clean=True)
+    return str(path)
+
+
+def test_book_only_freshness_reaches_a_dead_book_the_union_check_cannot_see(tmp_path):
+    """RED against HEAD: `PairCoverage` has no `book_uncovered_fraction` at all (AttributeError).
+
+    Half the capture's book channel is stone dead while trades keep the UNION dense — the
+    pre-existing B1 hole, still true and still pinned unchanged (B-v) — but the book-ONLY
+    instrument must reach it.
+    """
+    path = _write_book_dies_trades_flow(tmp_path / "death.jsonl")
+    meta = read_capture(path)
+    cov = meta.coverage_by_pair["BTC/USD"]
+
+    # the pre-existing, UNCHANGED B1 fact (B-v: nothing here may move this)
+    assert cov.uncovered_fraction < 0.01, (
+        "the union-denominated fraction must stay exactly as B1 measured it — trades alone keep "
+        "it dense; B2 must not touch this quantity")
+
+    # the NEW, book-ONLY instrument — the point of the row
+    assert cov.book_uncovered_fraction is not None
+    assert cov.book_uncovered_fraction > 0.45, (
+        "the book has had no event at all for half the capture; the book-only freshness term "
+        "must reach that even though the trade-backed union coverage above cannot")
+
+
+def test_book_uncovered_fraction_is_fail_closed_like_its_union_sibling(tmp_path):
+    """Same NO-CLAIM sentinel discipline as `uncovered_fraction` — `accounted_s <= 0` must never
+    read as `0.0` (the strongest possible claim) for the book-only term either."""
+    from capture import PairCoverage
+    cov = PairCoverage(pair="X", n_data_events=0, window_s=15.0, span_s=0.0,
+                        recorded_gap_s=0.0, accounted_s=0.0, covered_s=0.0, book_covered_s=0.0)
+    assert cov.book_uncovered_fraction is None
+
+
+# -------------------------------------------------------------------------------------------------
+# item 1, cycle-2 BLOCKER — the freshness term must measure WIRE EVIDENCE, not price change
+# -------------------------------------------------------------------------------------------------
+
+def _write_still_but_healthy(path, pair="BTC/USD", span_s=3600.0):
+    """CASE A. A flawless, fully-observed feed whose only property is that the market was STILL:
+    a book event every 1.0s for the whole span, top of book frozen for ~75% of it, but every
+    frame carrying a CHANGING SIZE (i.e. the venue really did send us a frame), trades printing
+    INSIDE the spread, zero gaps, zero keepalive overruns.
+
+    Cycle 1 scored this `book_uncovered_fraction 67.7%` -> EXCLUDED, i.e. WORSE than a book that
+    had stopped transmitting entirely. That is the term failing to discriminate the shape it
+    exists for.
+    """
+    w = CaptureWriter(str(path), [pair], "capStill", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    bid, ask = 79663.7, 79663.8
+    t, frozen, phase_end = 0.0, True, 300.0
+    i = 0
+    while t < span_s:
+        if t >= phase_end:
+            frozen = not frozen
+            phase_end = t + (300.0 if frozen else 100.0)
+        if not frozen:
+            bid, ask = round(bid + 0.1, 2), round(ask + 0.1, 2)
+        # the SIZE moves on every single frame — this is the wire evidence
+        w.write_book(pair, t, bid, ask, 1.0 + (i % 7) * 0.01, 2.0)
+        if i % 10 == 0:
+            w.write_trade(pair, t + 0.05, round((bid + ask) / 2.0, 2), 0.01, "buy", venue_ts=t)
+        if i % 10 == 0:
+            w.write_heartbeat(t)
+        i += 1
+        t += 1.0
+    w.close(clean=True)
+    return str(path)
+
+
+def _write_dead_book(path, pair="BTC/USD", span_s=3600.0, book_stop_s=1800.0):
+    """CASE B. The contrast the term must catch: the book stops transmitting at the midpoint
+    while trades keep flowing. Cycle 1 scored this 49.5% — BETTER than case A."""
+    w = CaptureWriter(str(path), [pair], "capDead", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    bid, ask = 79663.7, 79663.8
+    t, i = 0.0, 0
+    while t < span_s:
+        if t <= book_stop_s:
