+def _write_receipt_lag_fixture_healthy(path, pair="BTC/USD", span_s=7200.0, trade_every_s=20.0):
+    """A capture that clears gate (iv) on its own (book at just the two span edges; TRADES dense
+    enough, every `trade_every_s`, to keep the UNION coverage inside the 2% bound) — so a render
+    test can check the receipt-lag TEXT without also having to build a fully dense book. A
+    handful of trades carry deliberately chosen `venue_ts` lags (including one NEGATIVE and one
+    absent `venue_ts`); every other trade carries `venue_ts == ts` (zero lag) as baseline noise.
+    """
+    w = CaptureWriter(str(path), [pair], "capLagHealthy", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    w.write_book(pair, 0.0, 100.0, 100.2, 1.0, 1.0)
+    w.write_book(pair, span_s, 100.0, 100.2, 1.0, 1.0)
+    lag_overrides = {100.0: 98.0, 200.0: 197.0, 300.0: 301.0, 3700.0: 3690.0}
+    no_venue_ts_at = {3800.0}
+    t = 0.0
+    while t <= span_s:
+        if t in no_venue_ts_at:
