+def _write_flagged_run_for(path, pair, capture_id, n_defective=60, span_s=4000.0,
+                            freeze_at=1200.0, freeze_last=1500.0):
+    """One capture, one pair, one FLAGGED frozen run whose SIZE (number of defective prints) is
+    caller-chosen — so two such captures produce visibly different exclusion counts."""
+    w = CaptureWriter(str(path), [pair], capture_id, channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    # SIZES cycle even inside the freeze, so full-payload identity never fires and the book-mid
+    # FRESHNESS term measures a fully observed book: the pair must be excluded by NOTHING here,
+    # or the per-capture disclosure this test reads would never be rendered.
+    t, k = 0.0, 0
+    while t <= span_s:
+        sz = 1.0 + (k % 7) * 0.5
+        if freeze_at <= t <= freeze_last:
+            w.write_book(pair, t, 105.0, 105.2, sz, sz)
+        elif k % 2 == 0:
+            w.write_book(pair, t, 100.0, 100.2, sz, sz)
+        else:
+            w.write_book(pair, t, 100.1, 100.3, sz, sz)
+        t += 5.0
+        k += 1
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 20.0
+    t = 0.0
+    while t <= span_s:
+        if not (freeze_at - 30.0 <= t <= freeze_last + 30.0):
+            w.write_trade(pair, t, 100.15, 0.1, "buy", venue_ts=t)
+        t += 10.0
+    for i in range(n_defective):
+        ts = freeze_at + 1.0 + i * ((freeze_last - freeze_at - 2.0) / n_defective)
+        w.write_trade(pair, ts, 500.0, 0.1, "buy", venue_ts=ts)
+    w.close(clean=True)
+    return str(path)
+
