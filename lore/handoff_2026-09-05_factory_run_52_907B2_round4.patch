+def _write_outside_book_fixture(path, frozen_outside_n, frozen_inside_n, active_outside_n,
+                                 active_inside_n, adversarial_backdated_trade=False,
+                                 pair="BTC/USD"):
+    """ACTIVE book [0, 100) changes every 5s (never frozen); FROZEN book [100, 700] holds
+    `(105.0, 105.2)` constant (a run of 600s, well past `STALE_BOOK_MIN_RUN_S`). Trades are
+    placed densely in the active window (INSIDE/OUTSIDE per the requested counts) and sparsely in
+    the frozen window (ditto) so the two rates are independently controllable.
+    """
+    w = CaptureWriter(str(path), [pair], "capOutside", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    t, bid = 0.0, 100.0
+    while t < 100.0:
+        w.write_book(pair, t, bid, bid + 0.2, 1.0, 1.0)
+        bid += 0.001
+        t += 5.0
+    t = 100.0
+    while t <= 700.0:
+        w.write_book(pair, t, 105.0, 105.2, 1.0, 1.0)
+        t += 5.0
+
+    # active-window trades: densely spaced, `active_outside_n` outside / `active_inside_n` inside
+    active_n = active_outside_n + active_inside_n
+    for i in range(active_n):
+        ts = 1.0 + i * (98.0 / max(1, active_n))
+        price = 200.0 if i < active_outside_n else 100.1  # 200.0 sits far outside any active quote
+        w.write_trade(pair, ts, price, 0.1, "buy", venue_ts=ts)
+
+    # frozen-window trades: spread evenly across (100, 700) so they always land INSIDE the
+    # frozen book's own span regardless of count.
+    frozen_n = frozen_outside_n + frozen_inside_n
+    frozen_spacing = 590.0 / max(1, frozen_n - 1) if frozen_n > 1 else 0.0
+    for i in range(frozen_n):
+        ts = 105.0 + i * frozen_spacing
+        price = 200.0 if i < frozen_outside_n else 105.1  # 105.1 sits inside (105.0, 105.2)
+        w.write_trade(pair, ts, price, 0.1, "buy", venue_ts=ts)
+
+    if adversarial_backdated_trade:
+        # local ts sits INSIDE the frozen window, but venue_ts sits BEFORE the freeze began — a
+        # correct reader must NOT count this as a frozen-run observation.
+        w.write_trade(pair, 150.0, 500.0, 0.1, "buy", venue_ts=50.0)
+
+    w.close(clean=True)
+    return str(path)
+
