+                       book_keepalive_s=5.0)
+    # 20000s span so the SUMMED 120s of silence is 0.6% — under the 1.0% aggregate backstop, so
+    # only the interval-scoped drift clause can be doing anything here.
+    span_s = 20000.0
+    holes = [(1000.1, 1059.9), (5000.1, 5059.9)]
+    t, bid = 0.0, 100.0
+    while t <= span_s:
+        if not any(lo < t < hi for lo, hi in holes):
