+def test_the_book_freshness_term_never_reports_0_on_a_dead_book_with_no_declared_policy(tmp_path):
+    """MAJOR_5. `declares_keepalive` used to gate BOTH `stale_runs` and `echo_runs`, so with no
+    declared `book_emission_policy`/`book_keepalive_s` every book event counted as wire evidence
+    and a book byte-identical for 100% of its span read
+    `book_uncovered_fraction = 0.0` — the strongest freshness claim the instrument can make, from
+    a measurement that had been switched off. `0.0` is the one value a freshness term that made no
+    measurement must never return (the same principle B2 item 1 applies to `uncovered_fraction`
+    at `accounted_s <= 0`).
+
+    Full-payload identity is observable from the record ALONE, so the fix is to MAKE the
+    measurement, not to refuse to: the term now reaches the dead book with or without the
+    declaration.
+    """
+    undeclared = read_capture(_write_identical_book_payloads(tmp_path / "undeclared.jsonl"))
+    cov = undeclared.coverage_by_pair["BTC/USD"]
+    assert undeclared.declared_book_emission_policy is None
+    assert undeclared.declared_book_keepalive_s is None
+    assert cov.book_uncovered_fraction is not None
+    assert cov.book_uncovered_fraction > 0.9, (
+        f"a book byte-identical for its whole span is not an observed book; got "
+        f"{cov.book_uncovered_fraction}")
+    # the pre-existing B1 fact is UNCHANGED — the union term still cannot see this (B-v)
+    assert cov.uncovered_fraction < 0.01
+    # and the pair is EXCLUDED rather than publishing markouts on a mid that never moved
+    reason = undeclared.b2_freshness_disqualified_pairs()["BTC/USD"]
+    assert "book-mid freshness" in reason
+
