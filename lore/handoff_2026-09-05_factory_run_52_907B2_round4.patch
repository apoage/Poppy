+def _span_index(starts: List[float], spans: List[Tuple[float, float]],
+                 t: Optional[float], half_open: bool = False) -> int:
+    """Index of the span in `spans` (sorted, disjoint; `starts` its start column) containing `t`,
+    or -1. `None` never lands in a span.
+
+    **BOUNDARY RULE, and both settings are used deliberately** (`_pair_outside_book_stats`):
+
+      * `half_open=False` (default) — CLOSED `[lo, hi]`. This is the EXCLUSION rule: a trade that
+        touches either edge of a frozen run MIGHT have been struck during the freeze, and a trade
+        that might have been struck during a freeze must not be allowed to define what "normal"
+        looks like. Fail-closed on both boundaries.
+      * `half_open=True` — `[lo, hi)`. This is the POPULATION-ASSIGNMENT rule: adjacent frozen-top
+        runs SHARE an endpoint (one run's `end_ts` is the frame that started the next), and the
+        instant that frame arrives its new top IS the as-of book, so a trade at exactly `end_ts`
+        belongs to the NEXT run. Closed spans here would put such a trade in two runs at once.
+    """
+    if t is None or not spans:
+        return -1
+    j = bisect.bisect_right(starts, t) - 1
+    if j < 0:
+        return -1
+    lo, hi = spans[j]
+    return j if (lo <= t < hi if half_open else lo <= t <= hi) else -1
+
