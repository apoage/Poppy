+def _write_trailing_window_print(path, pair="BTC/USD", span_s=5000.0,
+                                  freeze_at=1200.0, freeze_last=1800.0, declare=True):
+    """THE BLOCKER-1 GEOMETRY, in-suite.
+
+    The book is frozen at `(105.0, 105.2)` from `freeze_at`; the LAST frame that REPEATS that top
+    is at `freeze_last`, and the first frame that CHANGES it is one declared keepalive later
+    (`freeze_last + 5.0`). Every print inside the freeze is at 500.0 — wholly outside the touch,
+    which is what FLAGS the run.
+
+    The one print that decides this test sits at `freeze_last + 2.5`: after the last repeat frame,
+    before the changing frame, walking through the SAME frozen book. Cycle 3 closed the run at
+    `freeze_last`, so that print fell OUTSIDE the flagged span and priced a virtual limit at 500.0
+    which the next, clean bar's 100.1 prints then filled — the run-51 leak, and NOT reachable by
+    cycle 3's limit-provenance fix, which was denominated correctly but on an under-covered span.
+
+    `declare=False` produces the BLOCKER-3 variant: the same shape from a recorder that declared no
+    `book_emission_policy`/`book_keepalive_s`. The SIZES cycle throughout so full-payload identity
+    never fires — the module's own "case A" — which is exactly why the payload-identity freshness
+    term cannot stand in for the 2b detector here.
+    """
+    kwargs = ({"book_emission_policy": BOOK_EMISSION_POLICY, "book_keepalive_s": 5.0}
+              if declare else {})
+    w = CaptureWriter(str(path), [pair], "capTrailWindow", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, **kwargs)
+    t, bid, k = 0.0, 100.0, 0
+    while t <= span_s:
+        sz = 1.0 + (k % 7) * 0.5   # sizes always move: no full-payload echo run, ever
+        if freeze_at <= t <= freeze_last:
+            w.write_book(pair, t, 105.0, 105.2, sz, sz)
+        else:
+            w.write_book(pair, t, bid, bid + 0.2, sz, sz)
+            bid += 0.0001
+        t += 5.0
+        k += 1
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 20.0
+    # baseline population: out-of-freeze prints inside their own touch
+    for i in range(40):
+        ts = 100.0 + i * 20.0
+        if freeze_at - 60.0 <= ts <= freeze_last + 120.0:
+            continue
+        w.write_trade(pair, ts, 100.1, 0.1, "buy", venue_ts=ts)
+    # ONE print positioned so that its 20m markout TARGET lands in the trailing keepalive window
+    # — after the last repeat frame, before the changing frame. Its anchor (601.0), its posting
+    # bar's close (580.0) and its target (1801.0) are ALL outside the run-51 base's under-covered
+    # `(start, last_repeat)` span, but the as-of observation backing the target is the frozen
+    # frame at 1800.0, INSIDE it. That is the BLOCKER-2 geometry (handoff: 20m, fill 880.0,
+    # target 2080.0, observation 2075.0 inside a flagged (2000.0, 2075.0)), and it is what
+    # `test_the_mid_provenance_gate_alone_drops_the_blocker2_geometry` isolates. Priced just under
+    # the surrounding 100.1 prints so it sets its own bar's LOW and becomes the fill anchor.
+    w.write_trade(pair, 601.0, 100.05, 0.1, "buy", venue_ts=601.0)
+    # the FLAGGED run's population: every print outside the frozen book
+    for i in range(100):
+        ts = freeze_at + 0.5 + i * ((freeze_last - freeze_at - 1.0) / 100)
+        w.write_trade(pair, ts, 500.0, 0.1, "buy", venue_ts=ts)
+    # THE PRINT: in the trailing window, alone in its own bar, still at the frozen-run level
+    w.write_trade(pair, freeze_last + 2.5, 500.0, 0.1, "buy", venue_ts=freeze_last + 2.5)
+    # clean prints resume in the NEXT bar and keep going so the horizons resolve
+    clean_start = freeze_last + 62.0
+    t = clean_start
+    while t <= span_s:
+        w.write_trade(pair, t, 100.1, 0.1, "buy", venue_ts=t)
+        t += 10.0
+    w.close(clean=True)
+    return str(path)
+
