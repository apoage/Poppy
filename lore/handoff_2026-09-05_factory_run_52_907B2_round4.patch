+# =================================================================================================
+# run-51 cycle 3 — BLOCKER_4: the CONTAMINATED LIMIT PRICE
+#
+# Every assertion in this section is on an OBSERVABLE of the published output — the markout
+# samples that came out and the drop counters the artifact prints. NONE of them asserts that a
+# particular predicate inside `run_shadow` returned True. That distinction is the whole reason
+# this block exists: cycle 2 shipped a test asserting the same anchor-timestamp criterion its
+# implementation used, so test and implementation shared one blind spot and a judge disproved the
+# fix by re-running the repro verbatim.
+# =================================================================================================
+
+def _write_contaminated_close(path, pair="BTC/USD", span_s=5000.0, freeze_at=2520.0):
+    """The orchestrator's run-51 repro, in-suite.
+
+    A freeze long enough to be a stale run AND to fully contain whole minute bars, so a bar CLOSE
+    is set by a flagged-run print. The book is frozen at (105.0, 105.2); every print inside the
+    freeze lands at **500.0** — wholly outside the touch, which is what flags the run. The bar
+    that closes INSIDE the freeze therefore prices a virtual limit at 500.0, and the first clean
+    prints after the freeze (back at 100.1) touch it — five seconds PAST the run's end, so the
+    fill's own timestamps are clean and the anchor test alone cannot see the contamination.
+    """
+    from capture import STALE_BOOK_MIN_RUN_S as _MIN_RUN
+    from shadow_engine import BAR_SECONDS as _BAR
+    freeze_len = max(_MIN_RUN + 5.0, 3 * _BAR + 5.0)
+    w = CaptureWriter(str(path), [pair], "capContaminated",
+                       channels=list(SUBSCRIBED_CHANNELS), heartbeat_timeout_s=30.0,
+                       book_emission_policy=BOOK_EMISSION_POLICY, book_keepalive_s=5.0)
+    t, bid = 0.0, 100.0
+    while t <= span_s:
+        if freeze_at <= t <= freeze_at + freeze_len:
+            w.write_book(pair, t, 105.0, 105.2, 1.0, 1.0)
+        else:
+            w.write_book(pair, t, bid, bid + 0.2, 1.0, 1.0)
+            bid += 0.0001
+        t += 5.0
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 20.0
+    for i in range(40):  # baseline population: out-of-freeze prints inside their own touch
+        ts = 200.0 + i * 40.0
+        if freeze_at - 60.0 <= ts <= freeze_at + freeze_len + 60.0:
+            continue
+        w.write_trade(pair, ts, 100.1, 0.1, "buy", venue_ts=ts)
+    for i in range(100):  # the FLAGGED run: every print at 500.0 against a frozen (105.0, 105.2)
+        ts = freeze_at + 0.5 + i * ((freeze_len - 1.0) / 100)
+        w.write_trade(pair, ts, 500.0, 0.1, "buy", venue_ts=ts)
+    clean_start = freeze_at + freeze_len + 5.0
+    for i in range(30):  # the CLEAN bar right after the freeze: legitimate prints, real level
+        ts = clean_start + i * 2.0
+        w.write_trade(pair, ts, 100.1, 0.1, "buy", venue_ts=ts)
+    for i in range(60):  # keep printing so the markout horizons resolve
+        ts = clean_start + 70.0 + i * 10.0
+        w.write_trade(pair, ts, 100.1, 0.1, "buy", venue_ts=ts)
+    w.close(clean=True)
+    return str(path)
+
