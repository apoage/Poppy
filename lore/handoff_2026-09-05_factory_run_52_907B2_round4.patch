+                       heartbeat_timeout_s=650.0,
+                       book_emission_policy=BOOK_EMISSION_POLICY, book_keepalive_s=5.0)
+    # Outside the freeze the top ALTERNATES between two values every frame, so no other frozen
+    # run can form, and every baseline print at 100.15 sits inside the touch either way — the
+    # out-of-freeze baseline is therefore a measured 0.0% outside, which is what lets the frozen
+    # run's 100% read as an excess rather than as the pair's ambient behaviour.
+    t, k = 0.0, 0
+    while t <= span_s:
+        if not (hole[0] < t < hole[1]):
+            if freeze_at <= t <= freeze_last:
+                w.write_book(pair, t, 105.0, 105.2, 1.0, 1.0)
+            elif k % 2 == 0:
+                w.write_book(pair, t, 100.0, 100.2, 1.0, 1.0)
+            else:
+                w.write_book(pair, t, 100.1, 100.3, 1.0, 1.0)
+        t += 5.0
+        k += 1
