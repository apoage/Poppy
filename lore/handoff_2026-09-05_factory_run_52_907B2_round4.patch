+def test_a_frozen_run_ends_at_the_frame_that_CHANGED_the_top_not_the_last_repeat(tmp_path):
+    """BLOCKER 1, at the quantity level. RED at the run-51 base: `_close_book_run` appended
+    `(run["start"], run["last"])`, so `OutsideBookRun.end_ts` WAS the last repeat frame and the
