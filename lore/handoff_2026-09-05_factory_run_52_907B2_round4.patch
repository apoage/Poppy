+def _write_unexplained_silence(path, n_holes=1, span_s=10000.0, hole_step_s=1000.0,
+                                pair="BTC/USD", declare=True, schema_mismatch=0):
+    """Book silences past the declared keepalive floor with ZERO recorded-gap overlap, in a
+    capture that is otherwise clean: the price never repeats (so no frozen run, so no
+    outside-book defect signal), no gap is recorded anywhere, and trades flow throughout.
+
+    Each hole is sized so the surviving inter-event interval is exactly 60.0s — comfortably past
+    the 10s overrun threshold (declared floor 5.0s x `BOOK_KEEPALIVE_OVERRUN_FACTOR`) and NOT past
+    the reader's 60s gap-detect threshold, so the shape under test is unexplained SILENCE and not
+    an unrecorded gap wearing its clothes.
+    """
+    kwargs = ({"book_emission_policy": BOOK_EMISSION_POLICY, "book_keepalive_s": 5.0}
+              if declare else {})
+    w = CaptureWriter(str(path), [pair], "capSilence", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=650.0, **kwargs)
+    holes = [(1000.0 + i * hole_step_s + 0.1, 1000.0 + i * hole_step_s + 59.9)
+             for i in range(n_holes)]
+    t, bid = 0.0, 100.0
+    while t <= span_s:
+        if not any(lo < t < hi for lo, hi in holes):
+            w.write_book(pair, t, bid, bid + 0.2, 1.0, 1.0)
+            bid += 0.0001
+        t += 5.0
+    t = 0.0
+    while t <= span_s:
+        w.write_trade(pair, t + 0.001, 100.1, 0.1, "buy", venue_ts=t)
+        t += 10.0
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 20.0
+    if schema_mismatch:
+        w.write_counters(span_s, 0, schema_mismatch, 0)
+    w.close(clean=True)
+    return str(path)
+
+
