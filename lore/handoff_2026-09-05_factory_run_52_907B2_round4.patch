+def test_a_pair_disqualified_in_EVERY_capture_is_excluded_not_a_B4_refusal(tmp_path):
+    """CASE 3. **Reproduced in cycle 2:** two captures each carrying a dying `BTC/USD` plus one
+    distinct healthy pair. Cycle 2's collision check fired on mere APPEARANCE in more than one
+    capture, so the invocation refused at rc=1 with no artifact and `ETH/USD` and `SOL/USD` — both
+    healthy, both backed by exactly one capture each — were discarded.
+
+    B4's stated concern is "which capture's number silently wins", and that cannot arise when no
+    number is produced anywhere. This is the D73 over-refusal shape one layer up.
+    """
+    cap_a = _write_dying_pair_plus_healthy(tmp_path / "a.jsonl", "ETH/USD", "capA")
+    cap_b = _write_dying_pair_plus_healthy(tmp_path / "b.jsonl", "SOL/USD", "capB")
+    out = str(tmp_path / "three.md")
+    rc = cli.main(["--capture", cap_a, "--capture", cap_b, "--out", out])
+    assert rc == 0, ("a pair disqualified in EVERY contributing capture produces no number "
+                     "anywhere, so no number can silently win — refusing here voids every "
+                     "healthy pair in both captures")
+    report = Path(out).read_text()
+    assert "## ETH/USD" in report
+    assert "## SOL/USD" in report
+    assert "## BTC/USD" not in report, "the disqualified pair must publish no section at all"
+    assert "**BTC/USD** EXCLUDED EVERYWHERE" in report, (
+        "with no capture backing it the notice may state, unqualified, that it publishes nowhere")
+    # the exclusion is SCOPED: both captures are named, because both excluded it
+    assert f"excluded in capture `{cap_a}`" in report
+    assert f"excluded in capture `{cap_b}`" in report
