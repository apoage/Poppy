+def _write_identical_book_payloads(path, pair="BTC/USD", span_s=3600.0, declare=False):
+    """A book emitting a BYTE-IDENTICAL `(bid, ask, bid_sz, ask_sz)` payload for 100% of its span
+    while trades keep flowing. The recorder that produced it declared no emission policy."""
+    kwargs = ({"book_emission_policy": BOOK_EMISSION_POLICY, "book_keepalive_s": 5.0}
+              if declare else {})
+    w = CaptureWriter(str(path), [pair], "capEcho", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, **kwargs)
+    t = 0.0
+    while t <= span_s:
+        w.write_book(pair, t, 100.0, 100.2, 1.0, 1.0)
+        t += 5.0
+    t = 0.0
+    while t <= span_s:
+        w.write_trade(pair, t + 0.001, 100.1, 0.1, "buy", venue_ts=t)
+        t += 10.0
+    w.close(clean=True)
+    return str(path)
+
