+    dead = read_capture(_write_dead_book(tmp_path / "dead.jsonl"))
+    still_frac = still.coverage_by_pair["BTC/USD"].book_uncovered_fraction
+    dead_frac = dead.coverage_by_pair["BTC/USD"].book_uncovered_fraction
+    assert dead_frac > 0.45
+    assert dead_frac > still_frac, (
+        "a book that STOPPED must score worse than a book that kept transmitting a still market")
