+def test_an_excluded_post_produces_no_markout_candidate_and_is_counted_once(tmp_path):
+    """The accounting identity, extended to the post level. Every post is either counted in
+    `n_posted` or in exactly ONE exclusion counter; every candidate lands in exactly one bucket;
