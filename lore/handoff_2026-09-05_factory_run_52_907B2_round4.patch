+def _write_two_freezes(path, pair="BTC/USD", span_s=4000.0,
+                        healthy_freeze_at=1000.0, defective_freeze_at=2500.0,
+                        n_healthy_trades=1000, n_defective_trades=50,
+                        defective_outside_frac=1.0, n_active_trades=40):
+    """The panel's convergent repro, both halves in one file.
+
+    Two frozen runs of the same length. The FIRST is healthy — many trades, all printing inside
+    the frozen touch. The SECOND is defective — far fewer trades, all printing far outside it.
+    Cycle 1 pooled every trade in the capture into one baseline and one frozen rate, so the
+    defective run's 50 prints were swamped by the healthy run's 1000 and the pair published clean.
+    """
+    freeze_len = STALE_BOOK_MIN_RUN_S + 5.0
+    w = CaptureWriter(str(path), [pair], "capTwoFreezes", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    t, bid = 0.0, 100.0
+    while t <= span_s:
+        if healthy_freeze_at <= t <= healthy_freeze_at + freeze_len:
+            w.write_book(pair, t, 105.0, 105.2, 1.0, 1.0)
+        elif defective_freeze_at <= t <= defective_freeze_at + freeze_len:
+            w.write_book(pair, t, 105.0, 105.2, 1.0, 1.0)
+        else:
+            w.write_book(pair, t, bid, bid + 0.2, 1.0, 1.0)
+            bid += 0.0001
+        t += 5.0
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 20.0
+    # out-of-freeze prints: the BASELINE population. Every one lands inside its own moving touch
+    # (bid drifts 100.0 -> ~100.08, ask = bid + 0.2), so the clean baseline rate is 0%.
+    for i in range(n_active_trades):
+        ts = 1500.0 + i * (2350.0 / max(1, n_active_trades))
+        if defective_freeze_at - 30.0 <= ts <= defective_freeze_at + freeze_len + 30.0:
+            continue
+        w.write_trade(pair, ts, 100.1, 0.1, "buy", venue_ts=ts)
+    # healthy freeze: many prints, every one INSIDE (105.0, 105.2)
+    for i in range(n_healthy_trades):
+        ts = healthy_freeze_at + 0.5 + i * ((freeze_len - 1.0) / n_healthy_trades)
+        w.write_trade(pair, ts, 105.1, 0.1, "buy", venue_ts=ts)
+    # defective freeze: few prints, `defective_outside_frac` of them far OUTSIDE
+    n_out = int(round(n_defective_trades * defective_outside_frac))
+    for i in range(n_defective_trades):
+        ts = defective_freeze_at + 0.5 + i * ((freeze_len - 1.0) / n_defective_trades)
+        w.write_trade(pair, ts, 500.0 if i < n_out else 105.1, 0.1, "buy", venue_ts=ts)
+    w.close(clean=True)
+    return str(path)
+
+
