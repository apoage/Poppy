+def test_no_absurd_markout_is_published_from_a_limit_priced_by_a_flagged_run(tmp_path):
+    """The repro's own top-line observable. Pre-fix: `|bp|=7996.97 fill_ts=2710.0 limit=500.0000`
+    published at rc=0, dressed in an honest-looking "26 candidates excluded" disclosure.
+
+    The mechanism the fix had to reach: `run_shadow` posts `limit = VirtualLimit(price=bar.close)`,
+    and the membership test interrogated only `fill_ts`/`fill_venue_ts`/`target_ts` — all three of
+    which live in the NEXT bar. The bar the limit price came FROM was never asked about, so a
+    limit contaminated at 500.0 by a run flagged for printing wholly outside its book was touched
+    by a legitimate 100.1 print in the next, clean bar and published a ~8000 bp markout.
+    """
+    from shadow_engine import run_shadow
