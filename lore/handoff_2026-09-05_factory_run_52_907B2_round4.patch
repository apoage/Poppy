+def test_a_still_but_fully_observed_book_is_OBSERVED_not_excluded(tmp_path):
+    """RED against cycle 1 (`book_uncovered_fraction` 67.7%, pair EXCLUDED).
+
+    A pure keepalive echo is an event whose FULL `(bid, ask, bid_sz, ask_sz)` payload repeats the
+    previous one. A size-only change is WIRE EVIDENCE. Every frame here changes a size, so every
+    frame is an observation and the book is fully observed — while the frozen-PRICE share stays
+    disclosed by `stale_book_s`, which is the honest split of the two facts.
+    """
+    path = _write_still_but_healthy(tmp_path / "still.jsonl")
+    meta = read_capture(path)
+    cov = meta.coverage_by_pair["BTC/USD"]
+    assert cov.book_uncovered_fraction == pytest.approx(0.0), (
+        "a book that sent a frame every second is fully OBSERVED, whatever the price did")
+    assert "BTC/USD" not in meta.b2_freshness_disqualified_pairs()
+    # the market's stillness is still MEASURED and disclosed, just not as an instrument failure
+    assert cov.stale_book_s > 0.5 * cov.accounted_s
+
+
+def test_a_dead_book_is_still_UNOBSERVED_and_scores_worse_than_the_still_one(tmp_path):
+    """The discriminator has to point the RIGHT way round: cycle 1 scored the transmitting feed
