+def _write_bar_aligned_defective_segment(path, pair="BTC/USD", span_s=6000.0,
+                                          freeze_at=2400.0, freeze_last=3000.0,
+                                          with_defective_prints=True):
+    """A capture whose defective segment occupies WHOLE minute bars, `[2400, 3000)`.
+
+    `with_defective_prints=False` writes the byte-identical file minus the defective segment's
+    prints — the "those bars removed by hand" reference. The clean prints resume at 3060.0 in BOTH
+    variants, so the two files' surviving bar structure is identical and their estimand 2 must
+    agree exactly once the contaminated bars stop being counted.
+    """
+    w = CaptureWriter(str(path), [pair], "capBarAligned", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    t, k = 0.0, 0
+    while t <= span_s:
+        if freeze_at <= t <= freeze_last:
+            w.write_book(pair, t, 105.0, 105.2, 1.0, 1.0)
+        elif k % 2 == 0:
+            w.write_book(pair, t, 100.0, 100.2, 1.0, 1.0)
+        else:
+            w.write_book(pair, t, 100.1, 100.3, 1.0, 1.0)
+        t += 5.0
+        k += 1
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 20.0
+    t = 0.0
+    while t < freeze_at:
+        w.write_trade(pair, t, 100.15 + (0.02 if int(t) % 40 == 0 else -0.02), 0.1, "buy",
+                       venue_ts=t)
+        t += 10.0
+    if with_defective_prints:
+        t = freeze_at
+        while t < freeze_last:
