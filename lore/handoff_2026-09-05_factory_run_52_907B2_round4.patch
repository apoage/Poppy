+def _write_still_but_healthy(path, pair="BTC/USD", span_s=3600.0):
+    """CASE A. A flawless, fully-observed feed whose only property is that the market was STILL:
+    a book event every 1.0s for the whole span, top of book frozen for ~75% of it, but every
+    frame carrying a CHANGING SIZE (i.e. the venue really did send us a frame), trades printing
+    INSIDE the spread, zero gaps, zero keepalive overruns.
+
+    Cycle 1 scored this `book_uncovered_fraction 67.7%` -> EXCLUDED, i.e. WORSE than a book that
+    had stopped transmitting entirely. That is the term failing to discriminate the shape it
+    exists for.
+    """
+    w = CaptureWriter(str(path), [pair], "capStill", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    bid, ask = 79663.7, 79663.8
+    t, frozen, phase_end = 0.0, True, 300.0
+    i = 0
+    while t < span_s:
+        if t >= phase_end:
+            frozen = not frozen
+            phase_end = t + (300.0 if frozen else 100.0)
+        if not frozen:
+            bid, ask = round(bid + 0.1, 2), round(ask + 0.1, 2)
+        # the SIZE moves on every single frame — this is the wire evidence
+        w.write_book(pair, t, bid, ask, 1.0 + (i % 7) * 0.01, 2.0)
+        if i % 10 == 0:
+            w.write_trade(pair, t + 0.05, round((bid + ask) / 2.0, 2), 0.01, "buy", venue_ts=t)
+        if i % 10 == 0:
+            w.write_heartbeat(t)
+        i += 1
+        t += 1.0
+    w.close(clean=True)
+    return str(path)
+
+
+def _write_dead_book(path, pair="BTC/USD", span_s=3600.0, book_stop_s=1800.0):
+    """CASE B. The contrast the term must catch: the book stops transmitting at the midpoint
+    while trades keep flowing. Cycle 1 scored this 49.5% — BETTER than case A."""
+    w = CaptureWriter(str(path), [pair], "capDead", channels=list(SUBSCRIBED_CHANNELS),
+                       heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                       book_keepalive_s=5.0)
+    bid, ask = 79663.7, 79663.8
+    t, i = 0.0, 0
+    while t < span_s:
+        if t <= book_stop_s:
+            bid, ask = round(bid + 0.1, 2), round(ask + 0.1, 2)
+            w.write_book(pair, t, bid, ask, 1.0 + (i % 7) * 0.01, 2.0)
+        if i % 10 == 0:
+            w.write_trade(pair, t + 0.05, round((bid + ask) / 2.0, 2), 0.01, "buy", venue_ts=t)
+            w.write_heartbeat(t)
+        i += 1
+        t += 1.0
+    w.close(clean=True)
+    return str(path)
+
