+def test_no_known_false_phrase_survives_in_the_LANE_SOURCE(tmp_path):
+    """MINOR — the mechanical prose scanner for THIS half of the row.
+
+    The D65-amend-2 half shipped one (`test_no_prose_in_the_lane_claims_two_horizons_suffice`);
+    this half did not, and the consequence was that false claims MIGRATED from rendered text into
+    code COMMENTS, where no rendered-artifact grep could reach them. Each phrase below was live in
+    the run-51 tree at a named site.
+    """
+    lane = Path(__file__).resolve().parent
+    sources = ("capture.py", "render.py", "shadow_engine.py", "cli.py", "estimands.py")
+    banned = (
+        "used by nothing",                  # capture.py:572 (fixed once in render.py, one file over)
+        "NOT ONE OF THEM IS RULED",         # capture.py:220-230, false post-D77
+        "STALE BOOK TIME",                  # render.py:546,689 — no artifact contains that heading
+        "pending alternative",              # the removed two-way response framing
+        "OUTSIDE_BOOK_EXCESS_RESPONSE",     # removed by D77-amend (ii)
+    )
+    # A banned phrase may survive in exactly one place: QUOTED, on a COMMENT line that marks it as
+    # withdrawn. That is the same allowance `test_the_false_mechanistic_rationale_is_gone_from_
+    # BOTH_sites` makes, and it exists so the record of WHAT was false is not itself deleted.
+    withdrawal_markers = ("used to", "no longer", "withdrawn", "FALSE", "REMOVED", "was live")
+    offenders = []
+    for name in sources:
+        text = (lane / name).read_text()
+        for phrase in banned:
+            for i, line in enumerate(text.splitlines(), 1):
+                if phrase not in line:
+                    continue
+                stripped = line.strip()
+                quoted = f'"{phrase}' in line or f'{phrase}"' in line
+                if (stripped.startswith("#") and quoted
+                        and any(m in line for m in withdrawal_markers)):
+                    continue
+                offenders.append(f"{name}:{i}: {phrase!r}")
+        # "UNRULED" is legitimate elsewhere, but never on a line that also names the RULED
+        # unexplained-silence bound.
+        for i, line in enumerate(text.splitlines(), 1):
+            if "UNRULED" in line and "MAX_UNEXPLAINED_BOOK_SILENCE_FRACTION" in line:
+                offenders.append(f"{name}:{i}: UNRULED beside a RULED bound")
+    assert not offenders, "known-false prose still in the lane SOURCE: " + repr(offenders)
