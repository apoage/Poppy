+def test_bars_are_bucketed_on_local_receipt_ts_not_on_the_anchor(tmp_path):
+    """The corrected claim, pinned BEHAVIOURALLY rather than by reading a sentence.
+
+    `render.py` and `MarkoutSample.fill_venue_ts` both used to justify declining D74's full
+    re-anchoring with "it would re-bucket prints across bar boundaries and move every B1 number",
+    "because bars are bucketed on the anchor". That is FALSE: `_build_bars_and_mids` buckets each
+    trade on its OWN LOCAL RECEIPT `ts` (`bar_start = (ts // BAR_SECONDS) * BAR_SECONDS`) and
+    never consults `venue_ts`; `fill_ts` is DERIVED from the already-bucketed bar.
+
+    Proof: two captures identical in every receipt timestamp and price, differing ONLY in
+    `venue_ts` (offset by 40s — two thirds of a 60s bar, i.e. enough to re-bucket every print if
+    the bucketing consulted it). Every bucketing-derived quantity must be identical.
+    """
+    from shadow_engine import _build_bars_and_mids, run_shadow
+    pair = "BTC/USD"
+
+    def _write(p, venue_offset):
+        w = CaptureWriter(str(p), [pair], "capBucket", channels=list(SUBSCRIBED_CHANNELS),
+                           heartbeat_timeout_s=30.0, book_emission_policy=BOOK_EMISSION_POLICY,
+                           book_keepalive_s=5.0)
+        t, price = 0.0, 100.0
+        while t <= 1200.0:
+            price += 0.01 if int(t / 10) % 2 == 0 else -0.01
+            w.write_book(pair, t, price, price + 0.2, 1.0, 1.0)
+            w.write_trade(pair, t + 0.001, price, 0.1, "buy",
+                           venue_ts=t + 0.001 - venue_offset)
+            t += 10.0
+        w.close(clean=True)
+        return str(p)
+
+    a = _write(tmp_path / "v0.jsonl", 0.0)
+    b = _write(tmp_path / "v40.jsonl", 40.0)
+
+    bars_a, _ = _build_bars_and_mids(a)
+    bars_b, _ = _build_bars_and_mids(b)
+    assert sorted(bars_a[pair]) == sorted(bars_b[pair]), (
+        "the bar BOUNDARIES themselves must not move with venue_ts")
+    for start in bars_a[pair]:
+        ba, bb = bars_a[pair][start], bars_b[pair][start]
+        assert (ba.close, ba.high, ba.low, ba.close_ts, ba.high_ts, ba.low_ts) == \
+               (bb.close, bb.high, bb.low, bb.close_ts, bb.high_ts, bb.low_ts)
+
+    _ma, ra = run_shadow(a)
+    _mb, rb = run_shadow(b)
+    key = lambda r: sorted((s.horizon, s.side, s.fill_ts, s.fill_price,
+                            round(s.adverse_selection_bp, 12)) for s in r[pair].markouts)
+    assert key(ra) == key(rb), (
+        "every published markout is byte-identical under a 40s venue_ts shift — re-anchoring the "
+        "horizon on venue_ts would therefore re-bucket NOTHING, which is what makes the withdrawn "
+        "mechanistic rationale false")
+    assert ra[pair].markouts, "fixture must produce markouts"
