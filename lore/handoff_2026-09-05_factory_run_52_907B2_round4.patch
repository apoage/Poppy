+def test_the_mid_provenance_gate_alone_drops_the_blocker2_geometry(tmp_path):
+    """**Proof the BLOCKER-2 gate is NOT VACUOUS**, which it would be if it only ever fired on
+    geometries BLOCKER 1's endpoint fix already covers.
+
+    Honest statement of the interaction, carried in the code comment at the gate site too: once a
+    flagged run ends at the frame that CHANGED the top, an observation inside the run and a target
+    a few seconds past the last repeat are BOTH inside the span, so the target gate catches the
+    measured run-51 case. This gate's value is that the mid's provenance is checked in its OWN
+    right rather than resting on the span-endpoint invariant holding.
+
+    So the test forces the under-covered spans back — `end_ts = last_repeat_ts`, exactly the
+    run-51 base's geometry — and then isolates the mid gate by running the SAME capture twice:
+    once as shipped, and once with every quote's provenance rewritten to the as-of instant (which
+    is precisely what "no provenance" meant). The difference is the gate's own contribution.
+
+    RED at the run-51 base: the gate does not exist, so both runs drop the same number and
+    `assert 30 > 30` fails.
+    """
+    import dataclasses
+    import capture as capture_mod
+    import shadow_engine as se
+    from shadow_engine import run_shadow
+
+    path = _write_trailing_window_print(tmp_path / "provenance.jsonl")
+
+    def _undercovered(self):
+        """Every flagged run re-closed at its LAST REPEAT frame — the run-51 base's endpoint."""
+        return {p: [dataclasses.replace(r, end_ts=r.last_repeat_ts) for r in runs]
+                for p, runs in real_flagged(self).items()}
+
+    real_flagged = capture_mod.CaptureMetadata.outside_book_flagged_runs
+    real_mid_at = se.MidSeries.mid_at
+    try:
+        capture_mod.CaptureMetadata.outside_book_flagged_runs = _undercovered
+        _m, results_gated = run_shadow(path)
+        # now blind the gate the same way the base was blind: provenance == the as-of instant
+        se.MidSeries.mid_at = lambda self, t: (
+            None if real_mid_at(self, t) is None
+            else dataclasses.replace(real_mid_at(self, t), obs_ts=t, obs_venue_ts=None))
+        _m2, results_blind = run_shadow(path)
+    finally:
+        capture_mod.CaptureMetadata.outside_book_flagged_runs = real_flagged
+        se.MidSeries.mid_at = real_mid_at
+
+    gated = results_gated["BTC/USD"]
+    blind = results_blind["BTC/USD"]
+    assert blind.n_markout_candidates == gated.n_markout_candidates, (
+        "the two runs must differ ONLY in the mid gate, or this comparison proves nothing")
+    assert gated.n_markouts_dropped_outside_book_run > \
+        blind.n_markouts_dropped_outside_book_run, (
+        f"the mid-provenance gate must drop candidates NOTHING ELSE drops: gated "
+        f"{gated.n_markouts_dropped_outside_book_run} vs blind "
+        f"{blind.n_markouts_dropped_outside_book_run}")
+    assert len(gated.markouts) < len(blind.markouts), (
+        "and those candidates were being PUBLISHED before")
+    # every SURVIVING markout's backing observation is outside the under-covered flagged span.
+    # `target_ts - mid_age_s` reconstructs `obs_ts` exactly (`mid_at` sets `age_s = t - obs_ts`),
+    # so this reads the published samples rather than trusting the predicate.
+    from shadow_engine import HORIZONS_S
+    for s in gated.markouts:
+        obs_ts = (s.fill_ts + HORIZONS_S[s.horizon]) - s.mid_age_s
+        assert not (1200.0 <= obs_ts <= 1800.0), (
+            f"a published markout is still backed by an observation at {obs_ts} inside the "
+            f"under-covered flagged span (1200.0, 1800.0)")
+
