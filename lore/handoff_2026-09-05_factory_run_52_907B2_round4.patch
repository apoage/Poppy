+@dataclass(frozen=True)
+class OutsideBookRun:
+    """ADDENDUM B2 item 2b (run-50, cycle 2): ONE frozen `(bid, ask)` run of one pair, with its
+    own outside-book trade rate — the LOCALIZED form of the signal.
+
+    Cycle 1 measured one pooled rate per pair over every frozen run in the capture. That is the
+    same wrong-denomination shape this whole row exists to fix, one field over: a single defective
+    run dilutes to invisibility across a multi-day capture (measured, cycle 1: one healthy 62s
+    freeze of 1000 clean trades next to one defective 62s freeze of 50 trades printing 100% outside
+    at +230bp pooled to a 0.99 ratio and published clean). Detection is therefore per RUN, and the
+    remedy is matched to the run (LOCALIZED by ruling, D77-amend — `shadow_engine.run_shadow`
+    drops and counts this run's markout candidates and evaluation bars; the pair publishes).
+
+    `start_ts`/`end_ts`/`last_repeat_ts`/`open_at_capture_end` are `FrozenTopRun`'s — read that
+    docstring before quoting either endpoint. `[start_ts, end_ts]` is the span over which the
+    as-of top did not change; `end_ts` is the FIRST FRAME THAT CHANGED IT, which is a different
+    endpoint from FROZEN-MID BOOK TIME's (that one counts repeat frames only and stops at
+    `last_repeat_ts`).
+
+    `n`/`n_outside` count only trades whose OWN `venue_ts` places them inside the HALF-OPEN
+    `[start_ts, end_ts)` — never local receipt time; see `_pair_outside_book_stats`.
+    """
+    start_ts: float
+    end_ts: float
+    n: int
+    n_outside: int
+    rate: Optional[float]          # None when n == 0 — never 0.0, which is a measured claim
+    baseline_rate: Optional[float]
+    excess_ratio: Optional[float]  # rate / baseline_rate; None when either side is unmeasured
+    verdict: str                   # OUTSIDE_BOOK_FLAGGED | OUTSIDE_BOOK_CLEAN | ..._NOT_ASSESSED
+    #: `FrozenTopRun.last_repeat_ts` — the last frame that REPEATED the top. Kept for disclosure
+    #: so the reader can see how far the run's true end sits past B1's endpoint.
+    last_repeat_ts: float = 0.0
+    #: `FrozenTopRun.open_at_capture_end` — the run had not been ended by a changing frame when
+    #: the file ran out, so `end_ts` is the capture's own `end_ts`.
+    open_at_capture_end: bool = False
+
+    def describe(self) -> str:
+        rate_txt = "NO CLAIM (n=0)" if self.rate is None else f"{self.rate * 100:.3f}%"
+        base_txt = ("NO CLAIM" if self.baseline_rate is None
+                    else f"{self.baseline_rate * 100:.3f}%")
+        ratio_txt = "n/a" if self.excess_ratio is None else f"{self.excess_ratio:.2f}x"
+        tail = (" [OPEN AT CAPTURE END: no frame changed the top before the file ended, so the "
+                "span reaches the capture's own end_ts]" if self.open_at_capture_end
+                else f" (last repeat frame at {self.last_repeat_ts:.1f})")
+        return (f"[{self.start_ts:.1f}, {self.end_ts:.1f}] {self.verdict}: {rate_txt} outside "
+                f"(n={self.n}, venue_ts-restricted) vs. baseline {base_txt}, {ratio_txt} "
+                f"(bound {OUTSIDE_BOOK_EXCESS_FACTOR:g}x, min n {OUTSIDE_BOOK_MIN_FROZEN_TRADES})"
+                + tail)
+
