+def test_estimand2_equals_the_same_fixture_with_the_flagged_bars_removed_by_hand(tmp_path):
+    """RUN-51 MAJOR — ESTIMAND 2 WAS FULLY CONTAMINATED, and it is one of the two PRE-REGISTERED
+    estimands. `n_posted`/`n_touch_fills`/`n_trade_cross_fills` were incremented before and
+    independently of every flagged-run test, so the artifact's sentence "the flagged runs' markout
+    candidates are excluded from every published number" was FALSE of this estimand (measured:
+    published touch-fill rate 0.6235 against an honest 0.5000).
+
+    The reference is built the way the brief specifies: the SAME fixture with the defective bars'
+    prints removed by hand. Non-vacuity is proved in the same test by re-running the contaminated
+    fixture with the flagged-run map emptied — which is exactly the run-51 base's estimand-2
+    behaviour — and asserting the rates then DIFFER.
+    """
+    import capture as capture_mod
+    from shadow_engine import run_shadow
+    from estimands import compute_estimand2
+
+    contaminated = _write_bar_aligned_defective_segment(tmp_path / "e2_contaminated.jsonl")
+    reference = _write_bar_aligned_defective_segment(tmp_path / "e2_reference.jsonl",
+                                                      with_defective_prints=False)
+    meta_c, res_c = run_shadow(contaminated)
+    assert meta_c.outside_book_flagged_runs().get("BTC/USD"), "fixture must flag its run"
+    e2_c = compute_estimand2(res_c["BTC/USD"])
+    e2_r = compute_estimand2(run_shadow(reference)[1]["BTC/USD"])
+
+    assert e2_c.n_posts_excluded_outside_book_run > 0, (
+        "the defective bars must actually be excluded, or the equality below is trivial")
+    assert (e2_c.n_posted, e2_c.n_touch_fills, e2_c.n_trade_cross_fills) == \
+        (e2_r.n_posted, e2_r.n_touch_fills, e2_r.n_trade_cross_fills), (
+        f"estimand 2 over the contaminated fixture must equal estimand 2 over the same fixture "
+        f"with the flagged bars removed by hand: got {e2_c} vs {e2_r}")
+    assert e2_c.touch_fill_rate == pytest.approx(e2_r.touch_fill_rate)
+    assert e2_c.trade_cross_fill_rate == pytest.approx(e2_r.trade_cross_fill_rate)
+
+    # NON-VACUITY: with the flagged-run map emptied — the run-51 base's estimand-2 behaviour —
+    # the contaminated fixture's rates are DIFFERENT numbers.
+    real = capture_mod.CaptureMetadata.outside_book_flagged_runs
+    try:
+        capture_mod.CaptureMetadata.outside_book_flagged_runs = lambda self: {}
+        e2_base = compute_estimand2(run_shadow(contaminated)[1]["BTC/USD"])
+    finally:
+        capture_mod.CaptureMetadata.outside_book_flagged_runs = real
+    assert e2_base.n_posted != e2_c.n_posted, (
+        "un-gated, the defective bars are counted — if this is equal the fixture never "
+        "contaminated anything and the test above proves nothing")
+    assert e2_base.touch_fill_rate != pytest.approx(e2_c.touch_fill_rate), (
+        f"and the PUBLISHED RATE moves: contaminated {e2_base.touch_fill_rate} vs honest "
+        f"{e2_c.touch_fill_rate}")
