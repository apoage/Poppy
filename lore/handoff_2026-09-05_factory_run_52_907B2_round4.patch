+def _write_dying_pair_plus_healthy(path, healthy_pair, capture_id,
+                                    dying_pair="BTC/USD", book_stop_s=1800.0, span_s=3600.0):
+    """One capture carrying a DYING pair (book dead after `book_stop_s`, trades flowing to the
+    end) plus one healthy pair. Two such captures with DIFFERENT healthy pairs are the cycle-2
+    over-refusal repro: the dying pair is disqualified in BOTH, and cycle 2 refused the whole
+    invocation over it, discarding both healthy pairs."""
+    w = CaptureWriter(str(path), [dying_pair, healthy_pair], capture_id,
+                       channels=list(SUBSCRIBED_CHANNELS), heartbeat_timeout_s=30.0,
+                       book_emission_policy=BOOK_EMISSION_POLICY, book_keepalive_s=5.0)
+    t, bid = 0.0, 100.0
+    while t <= book_stop_s:
+        w.write_book(dying_pair, t, bid, bid + 0.2, 1.0, 1.0)
+        bid += 0.001
+        t += 5.0
+    hb = 0.0
+    while hb <= span_s:
+        w.write_heartbeat(hb)
+        hb += 10.0
+    t = 0.0
+    while t <= span_s:
+        w.write_trade(dying_pair, t, bid, 0.5, "buy" if int(t) % 2 == 0 else "sell", venue_ts=t)
+        t += 10.0
+    t, price = 0.0, 3000.0
+    i = 0
+    while t <= span_s:
+        price += 0.01 if i % 2 == 0 else -0.01
+        w.write_book(healthy_pair, t, price, price + 0.2, 1.0, 1.0)
+        w.write_trade(healthy_pair, t + 0.001, price, 0.1, "buy", venue_ts=t)
+        t += 10.0
+        i += 1
+    w.close(clean=True)
+    return str(path)
+
