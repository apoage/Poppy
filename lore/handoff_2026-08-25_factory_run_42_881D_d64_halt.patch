+def read_prune_history(run_dir: str) -> list[dict]:
+    out = []
+    f = os.path.join(run_dir, "prunes.jsonl")
+    if not os.path.exists(f):
+        return out
+    try:
+        with open(f) as fh:
+            for line in fh:
+                line = line.strip()
+                if line:
+                    try:
+                        out.append(json.loads(line))
+                    except Exception:
+                        continue
+    except OSError:
+        pass
+    return out
+
