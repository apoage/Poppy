    w_unit = (float(tier_cfg.vector_weight_unit) if tier_cfg.vector_weight_unit > 0.0
              else 1.0 / int(env_cfg0.n_assets))
    doc = build_trace_doc(
        tag=args.tag, checkpoint_label=checkpoint_label, decision_rule=args.decision_rule,
