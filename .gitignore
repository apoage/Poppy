# Training output (server-side, rsync'd back)
# (`runs/*` rather than `runs/` so the TASK_868 negation below can take effect — git cannot
# re-include anything under a directory excluded by name.)
runs/*
checkpoints/
logs/
# TASK_868: the D31 scope-3 duplicate-sweep report is a COMMITTED runs/-side artifact
# (the task file's own requirement) — un-ignore ONLY the named deliverable files, so no
# bytecode or scratch under the directory can ever be staged.
!runs/868_asset_identity_repair/
runs/868_asset_identity_repair/*
!runs/868_asset_identity_repair/duplicate_sweep.json
!runs/868_asset_identity_repair/baseline_attribution.json
!runs/868_asset_identity_repair/harvest_gate_i.py
!runs/868_asset_identity_repair/baseline_diffs/
!runs/868_asset_identity_repair/baseline_diffs/*.json
wandb/
output/

# 2026-07-05 reorg sweep
docs/Hindsight-optimal/
docs/research/
*.bak
*.old
nohup.out
hang_debug.log
out_*/
.jax_cache/
.xla_cache/
.antigravitycli/
jax_ckpt_easy*/
jax_ckpt_fast/
