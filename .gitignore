last_run_metrics.json
training_schedule_old.json
bloom/output/**/*.mp4
*.log
data/
# TASK_868: mcts_trader/data/ is tracked source (the `data/` rule above is for data dumps);
# un-ignore the package dir so NEW modules there (asset_aliases.py) are committable.
!mcts_trader/data/
!mcts_trader/data/*.py
research/
jax_ckpt_easy
jax_ckpt_fast
overnight_*.log.*
*.backup.*
benchmark_results.json

