# Environment
trader_env/
__pycache__/
*.pyc

# Data
trading_data.db
*.db
*.sqlite
# TASK_873: --promote-fixture-identity stages both files under .tmp before os.replace().
# `*.db` does NOT cover `.db.tmp`, so a crash mid-promote used to leave an untracked ~79MB
# blob that a careless `git add -A` could sweep into the repo. Ignore both staging paths.
fixtures/trading_fixture.db.tmp
fixtures/FIXTURE_IDENTITY.json.tmp

# Logs and Experiments
default_experiment_*/
debug_run.log
training.log
training_console.log
current_training_pid.txt
training_pid.txt

# Profiling artifacts
profile.stats
profile_debug.log
*.prof

# Temporary scripts
stress_test.py
debug_env.py

# Secrets
.env

# Deploy plumbing
.git-training-worktree/
.env-workstation

# Training output (server-side, rsync'd back)
# (`runs/*` rather than `runs/` so the TASK_868 negation below can take effect — git cannot
# re-include anything under a directory excluded by name.)
runs/*
checkpoints/
logs/
# TASK_883/D36 (2026-08-09): frame provenance is METADATA ABOUT A CHECKPOINT'S IDENTITY, not run
# output. These files are what every pinned eval command references and what the whole 882
# instrument reconciliation rested on — 5.3 KB total, and NOT reproducible once the checkpoint's
# training context is gone. They were nearly destroyed TWICE in three factory runs (runs 27 and 29)
# precisely because `runs/*` hid them from every clean-tree gate and from `git checkout`.
# sha256 sidecars are not a fix: they share the disk with what they check. Version control is.
# Generic on purpose — any future runs/<id>/frame_provenance*.json is tracked automatically.
!runs/*/
runs/*/*
!runs/*/frame_provenance*.json

# TASK_868: the D31 scope-3 duplicate-sweep report is a COMMITTED runs/-side artifact
# (the task file's own requirement) — un-ignore ONLY the named deliverable files, so no
# bytecode or scratch under the directory can ever be staged.
!runs/868_asset_identity_repair/
runs/868_asset_identity_repair/*
!runs/868_asset_identity_repair/duplicate_sweep.json
!runs/868_asset_identity_repair/baseline_attribution.json
!runs/868_asset_identity_repair/harvest_gate_i.py
!runs/868_asset_identity_repair/baseline_diffs/
!runs/868_asset_identity_repair/baseline_diffs/*.json
# TASK_869: the D31 (a3) wave's attribution record + TZ-invariance demo artifacts are
# COMMITTED runs/-side deliverables (the task file's scope 3) — same named-file-only pattern.
!runs/869_rebase_wave_semantics/
runs/869_rebase_wave_semantics/*
!runs/869_rebase_wave_semantics/baseline_attribution.json
!runs/869_rebase_wave_semantics/tz_demo/
runs/869_rebase_wave_semantics/tz_demo/*
!runs/869_rebase_wave_semantics/tz_demo/results_fixture_smoke.TZ-UTC.json
!runs/869_rebase_wave_semantics/tz_demo/results_fixture_smoke.TZ-Europe-Prague.json
wandb/
output/

