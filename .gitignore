# TASK_868: mcts_trader/data/ is tracked source (the `data/` rule above is for data dumps);
# un-ignore the package dir so NEW modules there (asset_aliases.py) are committable.
!mcts_trader/data/
!mcts_trader/data/*.py
research/
jax_ckpt_easy
jax_ckpt_fast
overnight_*.log.*
*.backup.*
benchmark_results.json

# dark-factory runtime (never commit)
.dark-factory/state.json
.dark-factory/run-*.jsonl
.dark-factory/verdicts/

# DB backups: the copies themselves are far too large for git, but their sha256
# sidecars are TRACKED so a backup identity is recoverable from history alone
# (same pattern TASK_873 pins the gitignored fixture with).
backups/*
!backups/*.sha256

# Checkpoint archive: blobs are large and disposable; MANIFESTs are TRACKED so what was
# archived or deleted (identity, score, size) is recoverable from git history alone.
archive/**
!archive/**/
!archive/**/MANIFEST_*.json
