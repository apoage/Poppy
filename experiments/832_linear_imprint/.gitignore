# Compiled artifacts — the importlib load of 830's corridor.py writes bytecode here.
__pycache__/
*.pyc
# Imprint checkpoints (flax checkpoint dirs; smoke + scheduled-run outputs stay local).
# TASK_861 adds suffixed variants (ckpt_smoke_teacher_vectors*, ...) — glob the prefixes.
ckpt_smoke*/
ckpt_imprint*/
# TASK_861 --teacher-vectors default outputs are SUFFIXED results (never the canon parity
# baseline results_fixture_smoke.json, which IS checked in) — keep them out of the tree.
results_fixture_smoke_teacher_vectors*.json
# TASK_863 --panel-frame-from-checkpoint default outputs are suffixed the same way.
results_fixture_smoke*_frame_pin.json
# TASK_864: the CANON recipe's default output is now suffixed too — every ordinary verification
# run lands here, and only an explicit --write-parity-baseline promotes onto the checked-in
# results_fixture_smoke.json (which stays tracked, and is the weight-ON artifact per SPEC.md).
results_fixture_smoke_local.json
